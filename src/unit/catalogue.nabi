//! The unit catalogue: SI base and derived units, units accepted with
//! the SI, and common other units with their NIST SP 811 factors
//! (exact where the definition is exact). Parsing and the error
//! suggestions read it.

use pkg::Dim;

/// One unit of the catalogue.
///
/// ```nabi
/// let ft = units::unit::catalogue::find("ft") ?? panic("ft");
/// assert(ft.scale == 0.3048 && ft.name == "foot");
/// ```
#[derive(Clone, PartialEq, Debug)]
pub struct Entry {
    /// The symbol (`"ft"`).
    pub symbol: str;
    /// The singular name (`"foot"`).
    pub name: str;
    /// The plural name (`"feet"`).
    pub plural: str;
    /// One of the unit in coherent SI units.
    pub scale: f64;
    /// The SI value of zero of the unit (temperature scales only).
    pub offset: f64;
    /// The dimension.
    pub dim: Dim;
    /// Whether SI prefixes apply (`km`, `kilometre`).
    pub prefixes: bool;
}

