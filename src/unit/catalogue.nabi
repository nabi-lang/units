const ALIASES: [(str, str); 25] = [
    ("meter", "m"),
    ("meters", "m"),
    ("liter", "L"),
    ("liters", "L"),
    ("l", "L"),
    ("°C", "degC"),
    ("℃", "degC"),
    ("°F", "degF"),
    ("℉", "degF"),
    ("°R", "degR"),
    ("°", "deg"),
    ("ohm", "Ω"),
    ("Ω", "Ω"),
    ("in", "inch"),
    ("feet", "ft"),
    ("foot", "ft"),
    ("hr", "h"),
    ("sec", "s"),
    ("kt", "kn"),
    ("u", "Da"),
    ("Btu_IT", "Btu"),
    ("BTU", "Btu"),
    ("angstrom", "Å"),
    ("tonne", "t"),
    ("lbs", "lb"),
];

/// Every unit of the catalogue, without prefixed forms.
///
/// ```nabi
/// let all = units::unit::catalogue::entries();
/// assert(all.iter().any(|e: units::unit::catalogue::Entry| e.symbol == "psi"));
/// ```
pub fn entries() -> List<Entry> {
    let out: List<Entry> = List::with_capacity(ENTRIES.len());
    for e in ENTRIES { out.push(e); }
    out
}

/// The catalogue unit written `text`: its symbol (`"ft"`), its name or
/// plural (`"foot"`, `"feet"`, any case), or a common other spelling
/// (`"meter"`, `"°C"`, `"in"`). No prefixes; `DynUnit::parse` adds them.
///
/// ```nabi
/// use units::unit::catalogue::find;
///
/// assert((find("Feet") ?? panic("feet")).symbol == "ft");
/// assert((find("°C") ?? panic("degC")).offset == 273.15);
/// assert((find("Degrees Fahrenheit") ?? panic("degF")).symbol == "degF");
/// assert(find("km") == none);
/// ```
pub fn find(text: str) -> Entry | none {
    if let e: Entry = find_symbol(text) { return e; }
    find_name(text)
}

// A symbol or another spelling of one, case as written.
pub(pkg) fn find_symbol(text: str) -> Entry | none {
    for e in ENTRIES {
        if e.symbol == text { return e; }
    }
    for (a, sym) in ALIASES {
        if a == text { return find_symbol(sym); }
    }
    none
}

// A name or plural in any case. The names are lower case but for the
// proper nouns of a few with a space (`degree Celsius`, `US gallon`),
// so only those take the slow comparison.
pub(pkg) fn find_name(text: str) -> Entry | none {
    for e in ENTRIES {
        if e.name == text || e.plural == text { return e; }
    }
    let low = text.to_lowercase();
    if low != text {
        for e in ENTRIES {
            if e.name == low || e.plural == low { return e; }
        }
        for (a, sym) in ALIASES {
            if a == low { return find_symbol(sym); }
        }
    }
    if low.contains(" ") {
        for e in ENTRIES {
            if e.name.to_lowercase() == low || e.plural.to_lowercase() == low { return e; }
        }
    }
    none
}

// The symbol closest to `text` by edit distance, or "" when nothing is
// within a third of its length (at least one edit).
pub(pkg) fn suggest(text: str) -> str {
    let best = "";
    let best_d = (text.char_count() / 3).max(1) + 1;
    for e in ENTRIES {
        for cand in [e.symbol, e.name] {
            let d = distance(text, cand);
            if d < best_d {
                best_d = d;
                best = e.symbol;
            }
        }
    }
    best
}

// Levenshtein distance over chars.
fn distance(a: str, b: str) -> usize {
    let x: List<char> = a.chars().collect();
    let y: List<char> = b.chars().collect();
    let prev: List<usize> = List::from_fn(y.len() + 1, |j| j);
    for i in 0..x.len() {
        let cur: List<usize> = List::with_capacity(y.len() + 1);
        cur.push(i + 1);
        for j in 0..y.len() {
            let sub = prev[j] + if x[i] == y[j] { 0 } else { 1 };
            cur.push(sub.min(prev[j + 1] + 1).min(cur[j] + 1));
        }
        prev = cur;
    }
    prev[y.len()]
}
