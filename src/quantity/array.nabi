// A scalar quantity or a number on the left of an array quantity:
// `1km .+ d`, `2s .* v`, `2.0 .* d`, `1.0 ./ t`.

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32, const L2: i32, const M2: i32, const T2: i32, const I2: i32, const K2: i32, const N2: i32, const J2: i32> ops::DotMul<Quantity<Array<f64, R>, L2, M2, T2, I2, K2, N2, J2>> for Quantity<f64, L, M, T, I, K, N, J> {
    type Output = Quantity<Array<f64, R>, { L + L2 }, { M + M2 }, { T + T2 }, { I + I2 }, { K + K2 }, { N + N2 }, { J + J2 }>;
    #[inline]
    fn dot_mul(self, rhs: Quantity<Array<f64, R>, L2, M2, T2, I2, K2, N2, J2>) -> Quantity<Array<f64, R>, { L + L2 }, { M + M2 }, { T + T2 }, { I + I2 }, { K + K2 }, { N + N2 }, { J + J2 }> { Quantity { value: self.value .* rhs.value } }
}

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32, const L2: i32, const M2: i32, const T2: i32, const I2: i32, const K2: i32, const N2: i32, const J2: i32> ops::DotDiv<Quantity<Array<f64, R>, L2, M2, T2, I2, K2, N2, J2>> for Quantity<f64, L, M, T, I, K, N, J> {
    type Output = Quantity<Array<f64, R>, { L - L2 }, { M - M2 }, { T - T2 }, { I - I2 }, { K - K2 }, { N - N2 }, { J - J2 }>;
    #[inline]
    fn dot_div(self, rhs: Quantity<Array<f64, R>, L2, M2, T2, I2, K2, N2, J2>) -> Quantity<Array<f64, R>, { L - L2 }, { M - M2 }, { T - T2 }, { I - I2 }, { K - K2 }, { N - N2 }, { J - J2 }> { Quantity { value: self.value ./ rhs.value } }
}

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotAdd<Quantity<Array<f64, R>, L, M, T, I, K, N, J>> for Quantity<f64, L, M, T, I, K, N, J> {
    type Output = Quantity<Array<f64, R>, L, M, T, I, K, N, J>;
