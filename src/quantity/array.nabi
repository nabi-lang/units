impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotLt<Quantity<Array<f64, R>, L, M, T, I, K, N, J>> for Quantity<Array<f64, R>, L, M, T, I, K, N, J> {
    type Output = Array<bool, R>;
    fn dot_lt(self, rhs: Quantity<Array<f64, R>, L, M, T, I, K, N, J>) -> Array<bool, R> { self.value .< rhs.value }
}

