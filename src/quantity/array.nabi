impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotSub<Quantity<f64, L, M, T, I, K, N, J>> for Quantity<Array<f64, R>, L, M, T, I, K, N, J> {
