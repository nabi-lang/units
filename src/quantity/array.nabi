}

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotSub<Quantity<Array<f64, R>, L, M, T, I, K, N, J>> for Quantity<f64, L, M, T, I, K, N, J> {
    type Output = Quantity<Array<f64, R>, L, M, T, I, K, N, J>;
    #[inline]
    fn dot_sub(self, rhs: Quantity<Array<f64, R>, L, M, T, I, K, N, J>) -> Quantity<Array<f64, R>, L, M, T, I, K, N, J> { Quantity { value: self.value .- rhs.value } }
}

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotMul<Quantity<Array<f64, R>, L, M, T, I, K, N, J>> for f64 {
    type Output = Quantity<Array<f64, R>, L, M, T, I, K, N, J>;
    #[inline]
    fn dot_mul(self, rhs: Quantity<Array<f64, R>, L, M, T, I, K, N, J>) -> Quantity<Array<f64, R>, L, M, T, I, K, N, J> { Quantity { value: self .* rhs.value } }
}

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotDiv<Quantity<Array<f64, R>, L, M, T, I, K, N, J>> for f64 {
    type Output = Quantity<Array<f64, R>, { -L }, { -M }, { -T }, { -I }, { -K }, { -N }, { -J }>;
    #[inline]
    fn dot_div(self, rhs: Quantity<Array<f64, R>, L, M, T, I, K, N, J>) -> Quantity<Array<f64, R>, { -L }, { -M }, { -T }, { -I }, { -K }, { -N }, { -J }> { Quantity { value: self ./ rhs.value } }
}

// A scalar quantity and a plain array: `lu .* x`, `x .* 2s`, `1m ./ x`,
// `x ./ 1s`. The array is a number per element, as for `f64`.

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotMul<Array<f64, R>> for Quantity<f64, L, M, T, I, K, N, J> {
    type Output = Quantity<Array<f64, R>, L, M, T, I, K, N, J>;
    #[inline]
    fn dot_mul(self, rhs: Array<f64, R>) -> Quantity<Array<f64, R>, L, M, T, I, K, N, J> { Quantity { value: self.value .* rhs } }
}

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotDiv<Array<f64, R>> for Quantity<f64, L, M, T, I, K, N, J> {
    type Output = Quantity<Array<f64, R>, L, M, T, I, K, N, J>;
    #[inline]
    fn dot_div(self, rhs: Array<f64, R>) -> Quantity<Array<f64, R>, L, M, T, I, K, N, J> { Quantity { value: self.value ./ rhs } }
}

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotMul<Quantity<f64, L, M, T, I, K, N, J>> for Array<f64, R> {
    type Output = Quantity<Array<f64, R>, L, M, T, I, K, N, J>;
    #[inline]
    fn dot_mul(self, rhs: Quantity<f64, L, M, T, I, K, N, J>) -> Quantity<Array<f64, R>, L, M, T, I, K, N, J> { Quantity { value: self .* rhs.value } }
}

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> ops::DotDiv<Quantity<f64, L, M, T, I, K, N, J>> for Array<f64, R> {
    type Output = Quantity<Array<f64, R>, { -L }, { -M }, { -T }, { -I }, { -K }, { -N }, { -J }>;
    #[inline]
    fn dot_div(self, rhs: Quantity<f64, L, M, T, I, K, N, J>) -> Quantity<Array<f64, R>, { -L }, { -M }, { -T }, { -I }, { -K }, { -N }, { -J }> { Quantity { value: self ./ rhs.value } }
}

impl<const R: usize, const L: i32, const M: i32, const T: i32, const I: i32, const K: i32, const N: i32, const J: i32> Quantity<Array<f64, R>, L, M, T, I, K, N, J> {
    /// The element at `idx`, a scalar quantity.
    ///
    /// ```nabi
    /// use core::array::Array;
    /// use units::symbols::m;
    ///
    /// assert(m.array(Array::from_list([4.0, 5.0], [2])).at([0]) == 4m);
    /// ```
    #[track_caller]
    pub fn at(self, idx: [usize; R]) -> Quantity<f64, L, M, T, I, K, N, J> { Quantity { value: self.value.at(idx) } }

    /// The shape of the values.
    ///
    /// ```nabi
    /// use core::array::Array;
    /// use units::symbols::s;
    ///
    /// let z: Array<f64, 2> = Array::zeros([2, 3]);
    /// assert(s.array(z).shape() == [2, 3]);
    /// ```
    pub fn shape(self) -> [usize; R] { self.value.shape() }

    /// The number of values.
    ///
    /// ```nabi
    /// use core::array::Array;
    /// use units::symbols::s;
    ///
    /// let z: Array<f64, 1> = Array::zeros([4]);
    /// assert(s.array(z).len() == 4);
    /// ```
    pub fn len(self) -> usize { self.value.len() }

    /// The values expressed in `unit`, plain numbers (a new array).
    ///
    /// ```nabi
    /// use core::array::Array;
    /// use units::symbols::{m, cm};
    ///
    /// let d = m.array(Array::from_list([1.0, 2.0], [2]));
    /// assert(d.values_in(cm).to_list() == [100.0, 200.0]);
    /// ```
    pub fn values_in(self, unit: Unit<L, M, T, I, K, N, J>) -> Array<f64, R> { self.value ./ unit.scale() }

    /// The sum of all values.
    ///
    /// ```nabi
    /// use core::array::Array;
    /// use units::symbols::m;
    ///
    /// assert(m.array(Array::from_list([1.0, 2.0], [2])).sum() == 3m);
    /// ```
    pub fn sum(self) -> Quantity<f64, L, M, T, I, K, N, J> { Quantity { value: self.value.sum() } }
}
