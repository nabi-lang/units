//! Unit constants named by their symbols, to import the ones you need:
//! `use units::symbols::{km, h, kg, m, s²};`. Each is a `Unit` constant, so
//! `q.to(mi)` and `q.value_in(km / h)` check the dimension at compile
//! time. Symbols that are not names are spelled out: `inch` (`in` is a
//! keyword), `deg`, `percent`, `delta_degC`. `m²`, `s²`, `s⁻¹` and the like
//! are names too, so `kg * m / s²` is a unit.

use pkg::Unit;
use pkg::temperature::Scale;

/// `m`: 1.0 SI units.
///
/// ```nabi
/// assert(units::symbols::m.symbol() == "m");
/// ```
pub const m: Unit<1, 0, 0, 0, 0, 0, 0> = Unit::new("m", 1.0);
/// `km`: 1e3 SI units.
///
/// ```nabi
/// assert(units::symbols::km.symbol() == "km");
/// ```
pub const km: Unit<1, 0, 0, 0, 0, 0, 0> = Unit::new("km", 1e3);
