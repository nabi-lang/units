/// ```
pub const eV: Quantity<f64, 2, 1, -2, 0, 0, 0, 0> = Quantity { value: 1.602176634e-19 };

const TABLE: [Codata; 27] = [
    Codata { symbol: "c", name: "speed of light in vacuum", value: 299792458.0, uncertainty: 0.0, unit: "m/s", exact: true },
    Codata { symbol: "h", name: "Planck constant", value: 6.62607015e-34, uncertainty: 0.0, unit: "J·s", exact: true },
    Codata { symbol: "ħ", name: "reduced Planck constant", value: 6.62607015e-34 / (2.0 * f64::PI), uncertainty: 0.0, unit: "J·s", exact: true },
    Codata { symbol: "e", name: "elementary charge", value: 1.602176634e-19, uncertainty: 0.0, unit: "C", exact: true },
    Codata { symbol: "k", name: "Boltzmann constant", value: 1.380649e-23, uncertainty: 0.0, unit: "J/K", exact: true },
    Codata { symbol: "N_A", name: "Avogadro constant", value: 6.02214076e23, uncertainty: 0.0, unit: "1/mol", exact: true },
    Codata { symbol: "Δν_Cs", name: "hyperfine transition frequency of Cs-133", value: 9192631770.0, uncertainty: 0.0, unit: "Hz", exact: true },
    Codata { symbol: "K_cd", name: "luminous efficacy of 540 THz radiation", value: 683.0, uncertainty: 0.0, unit: "lm/W", exact: true },
    Codata { symbol: "R", name: "molar gas constant", value: 6.02214076e23 * 1.380649e-23, uncertainty: 0.0, unit: "J/(mol·K)", exact: true },
    Codata { symbol: "F", name: "Faraday constant", value: 6.02214076e23 * 1.602176634e-19, uncertainty: 0.0, unit: "C/mol", exact: true },
    Codata { symbol: "σ", name: "Stefan-Boltzmann constant", value: 5.670374419184429453970996731889e-8, uncertainty: 0.0, unit: "W/(m²·K⁴)", exact: true },
    Codata { symbol: "G", name: "Newtonian constant of gravitation", value: 6.67430e-11, uncertainty: 0.00015e-11, unit: "m³/(kg·s²)", exact: false },
    Codata { symbol: "g_n", name: "standard acceleration of gravity", value: 9.80665, uncertainty: 0.0, unit: "m/s²", exact: true },
    Codata { symbol: "α", name: "fine-structure constant", value: 7.2973525643e-3, uncertainty: 0.0000000011e-3, unit: "1", exact: false },
    Codata { symbol: "μ₀", name: "vacuum magnetic permeability", value: 1.25663706127e-6, uncertainty: 0.00000000020e-6, unit: "N/A²", exact: false },
    Codata { symbol: "ε₀", name: "vacuum electric permittivity", value: 8.8541878188e-12, uncertainty: 0.0000000014e-12, unit: "F/m", exact: false },
    Codata { symbol: "Z₀", name: "characteristic impedance of vacuum", value: 376.730313412, uncertainty: 0.000000059, unit: "Ω", exact: false },
    Codata { symbol: "m_e", name: "electron mass", value: 9.1093837139e-31, uncertainty: 0.0000000028e-31, unit: "kg", exact: false },
    Codata { symbol: "m_p", name: "proton mass", value: 1.67262192595e-27, uncertainty: 0.00000000052e-27, unit: "kg", exact: false },
    Codata { symbol: "m_n", name: "neutron mass", value: 1.67492750056e-27, uncertainty: 0.00000000085e-27, unit: "kg", exact: false },
    Codata { symbol: "m_u", name: "atomic mass constant", value: 1.66053906892e-27, uncertainty: 0.00000000052e-27, unit: "kg", exact: false },
    Codata { symbol: "a_0", name: "Bohr radius", value: 5.29177210544e-11, uncertainty: 0.00000000082e-11, unit: "m", exact: false },
    Codata { symbol: "R_∞", name: "Rydberg constant", value: 10973731.568157, uncertainty: 0.000012, unit: "1/m", exact: false },
    Codata { symbol: "μ_B", name: "Bohr magneton", value: 9.2740100657e-24, uncertainty: 0.0000000029e-24, unit: "J/T", exact: false },
    Codata { symbol: "r_e", name: "classical electron radius", value: 2.8179403205e-15, uncertainty: 0.0000000013e-15, unit: "m", exact: false },
    Codata { symbol: "atm", name: "standard atmosphere", value: 101325.0, uncertainty: 0.0, unit: "Pa", exact: true },
    Codata { symbol: "eV", name: "electronvolt", value: 1.602176634e-19, uncertainty: 0.0, unit: "J", exact: true },
];

/// Every constant of this module, with its uncertainty.
///
/// ```nabi
/// assert(units::constants::codata().len() >= 20);
/// ```
pub fn codata() -> List<Codata> {
    let out: List<Codata> = List::with_capacity(TABLE.len());
    for c in TABLE { out.push(c); }
    out
}

/// The constant with symbol or name `text` (`"h"`, `"ħ"`, `"electron mass"`).
///
/// ```nabi
/// assert((units::constants::lookup("electron mass") ?? panic("m_e")).symbol == "m_e");
/// ```
pub fn lookup(text: str) -> Codata | none {
    for c in TABLE {
        if c.symbol == text || c.name == text { return c; }
    }
    none
}
