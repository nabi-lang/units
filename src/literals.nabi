//! Number suffixes for the common units: `3km`, `9.81m / 1s / 1s`, `5kΩ`,
//! `20degC`. Each gives a static `Quantity` (a `Temperature` for the
//! temperature scales). A suffix is a name glued to the number, so `m²`,
//! `μs` and `Ω` work, `%` and `°C` do not (`percent`, `degC`); none may
//! start with `e` (`2e3` is an exponent), so the electronvolt has `keV`,
//! `MeV`, ... but no `eV` suffix (write `eV.of(2.0)`).
//!
//! `ms` and `us` sit at priority -2, below the `f64` ones of the `signal`
//! package (-1), so adding this package never changes signal code: with
//! both, the slot picks (`5ms` where an `f64` goes is signal's, where a
//! `Time` goes this package's) and an untyped `let t = 5ms;` stays
//! signal's number of seconds; write `5μs` or `ms.of(5.0)` for a quantity.

use pkg::Quantity;
use pkg::temperature::{Scale, Temperature};

/// `1m` is one m.
///
/// ```nabi
/// assert(2m == units::symbols::m.of(2.0));
/// ```
#[literal(number "m")]
pub const fn metres(n: f64) -> pkg::kinds::Length { Quantity { value: n } }

/// `1km` is one km.
///
/// ```nabi
/// assert(2km == units::symbols::km.of(2.0));
/// ```
#[literal(number "km")]
pub const fn kilometres(n: f64) -> pkg::kinds::Length { Quantity { value: n * 1e3 } }

