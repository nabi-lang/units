/// ```nabi
/// use units::kinds::Capacitance;
///
/// let q: Capacitance = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [-2, -1, 4, 2, 0, 0, 0]);
/// ```
pub type Capacitance<V = f64> = Quantity<V, -2, -1, 4, 2, 0, 0, 0>;

/// Inductance (H).
///
/// ```nabi
/// use units::kinds::Inductance;
///
/// let q: Inductance = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -2, -2, 0, 0, 0]);
/// ```
pub type Inductance<V = f64> = Quantity<V, 2, 1, -2, -2, 0, 0, 0>;

/// Magnetic flux (Wb).
///
/// ```nabi
/// use units::kinds::MagneticFlux;
///
/// let q: MagneticFlux = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -2, -1, 0, 0, 0]);
/// ```
pub type MagneticFlux<V = f64> = Quantity<V, 2, 1, -2, -1, 0, 0, 0>;

/// Magnetic flux density (T).
///
/// ```nabi
/// use units::kinds::MagneticFluxDensity;
///
/// let q: MagneticFluxDensity = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 1, -2, -1, 0, 0, 0]);
/// ```
pub type MagneticFluxDensity<V = f64> = Quantity<V, 0, 1, -2, -1, 0, 0, 0>;

/// Electric field strength (V/m).
///
/// ```nabi
/// use units::kinds::ElectricField;
///
/// let q: ElectricField = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [1, 1, -3, -1, 0, 0, 0]);
/// ```
pub type ElectricField<V = f64> = Quantity<V, 1, 1, -3, -1, 0, 0, 0>;

/// Permittivity (F/m).
///
/// ```nabi
/// use units::kinds::Permittivity;
///
/// let q: Permittivity = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [-3, -1, 4, 2, 0, 0, 0]);
/// ```
pub type Permittivity<V = f64> = Quantity<V, -3, -1, 4, 2, 0, 0, 0>;

/// Permeability (H/m).
///
/// ```nabi
/// use units::kinds::Permeability;
///
/// let q: Permeability = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [1, 1, -2, -2, 0, 0, 0]);
/// ```
pub type Permeability<V = f64> = Quantity<V, 1, 1, -2, -2, 0, 0, 0>;

/// Entropy, heat capacity (J/K).
///
/// ```nabi
/// use units::kinds::Entropy;
///
/// let q: Entropy = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -2, 0, -1, 0, 0]);
/// ```
pub type Entropy<V = f64> = Quantity<V, 2, 1, -2, 0, -1, 0, 0>;

/// Specific heat capacity (J/(kg·K)).
///
/// ```nabi
/// use units::kinds::SpecificHeat;
///
/// let q: SpecificHeat = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 0, -2, 0, -1, 0, 0]);
/// ```
pub type SpecificHeat<V = f64> = Quantity<V, 2, 0, -2, 0, -1, 0, 0>;

/// Thermal conductivity (W/(m·K)).
///
/// ```nabi
/// use units::kinds::ThermalConductivity;
///
/// let q: ThermalConductivity = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [1, 1, -3, 0, -1, 0, 0]);
/// ```
pub type ThermalConductivity<V = f64> = Quantity<V, 1, 1, -3, 0, -1, 0, 0>;

/// Molar mass (kg/mol).
///
/// ```nabi
/// use units::kinds::MolarMass;
///
/// let q: MolarMass = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 1, 0, 0, 0, -1, 0]);
/// ```
pub type MolarMass<V = f64> = Quantity<V, 0, 1, 0, 0, 0, -1, 0>;

/// Molar energy (J/mol).
///
/// ```nabi
/// use units::kinds::MolarEnergy;
///
/// let q: MolarEnergy = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -2, 0, 0, -1, 0]);
/// ```
pub type MolarEnergy<V = f64> = Quantity<V, 2, 1, -2, 0, 0, -1, 0>;

/// Molar entropy, molar heat capacity (J/(mol·K)).
///
/// ```nabi
/// use units::kinds::MolarEntropy;
///
/// let q: MolarEntropy = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -2, 0, -1, -1, 0]);
/// ```
pub type MolarEntropy<V = f64> = Quantity<V, 2, 1, -2, 0, -1, -1, 0>;

/// Amount concentration (mol/m³).
///
/// ```nabi
/// use units::kinds::Concentration;
///
/// let q: Concentration = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [-3, 0, 0, 0, 0, 1, 0]);
/// ```
pub type Concentration<V = f64> = Quantity<V, -3, 0, 0, 0, 0, 1, 0>;

/// Catalytic activity (kat).
///
/// ```nabi
/// use units::kinds::CatalyticActivity;
///
/// let q: CatalyticActivity = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 0, -1, 0, 0, 1, 0]);
/// ```
pub type CatalyticActivity<V = f64> = Quantity<V, 0, 0, -1, 0, 0, 1, 0>;

/// Illuminance (lx).
///
/// ```nabi
/// use units::kinds::Illuminance;
///
/// let q: Illuminance = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [-2, 0, 0, 0, 0, 0, 1]);
/// ```
pub type Illuminance<V = f64> = Quantity<V, -2, 0, 0, 0, 0, 0, 1>;

/// Absorbed or equivalent dose (Gy, Sv); also specific energy (J/kg).
///
/// ```nabi
/// use units::kinds::AbsorbedDose;
///
/// let q: AbsorbedDose = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 0, -2, 0, 0, 0, 0]);
/// ```
pub type AbsorbedDose<V = f64> = Quantity<V, 2, 0, -2, 0, 0, 0, 0>;
