//! Names for the common dimensions, so signatures read as physics:
//! `fn kinetic(m: Mass, v: Velocity) -> Energy`. Each takes the value
//! type `V`, `f64` when left out (`Velocity` is `Velocity<f64>`; also
//! `f32`, `Complex<f64>`, `Array<f64, R>`).

use pkg::Quantity;

/// A pure number (also angles in radians and ratios).
///
/// ```nabi
/// use units::kinds::Dimensionless;
///
/// let q: Dimensionless = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 0, 0, 0, 0, 0, 0]);
/// ```
pub type Dimensionless<V = f64> = Quantity<V, 0, 0, 0, 0, 0, 0, 0>;

/// Length (m).
///
/// ```nabi
/// use units::kinds::Length;
///
/// let q: Length = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [1, 0, 0, 0, 0, 0, 0]);
/// ```
pub type Length<V = f64> = Quantity<V, 1, 0, 0, 0, 0, 0, 0>;

/// Mass (kg).
///
/// ```nabi
/// use units::kinds::Mass;
///
/// let q: Mass = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 1, 0, 0, 0, 0, 0]);
/// ```
pub type Mass<V = f64> = Quantity<V, 0, 1, 0, 0, 0, 0, 0>;

/// Time (s).
///
/// ```nabi
/// use units::kinds::Time;
///
/// let q: Time = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 0, 1, 0, 0, 0, 0]);
/// ```
pub type Time<V = f64> = Quantity<V, 0, 0, 1, 0, 0, 0, 0>;

/// Electric current (A).
///
/// ```nabi
/// use units::kinds::Current;
///
/// let q: Current = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 0, 0, 1, 0, 0, 0]);
/// ```
pub type Current<V = f64> = Quantity<V, 0, 0, 0, 1, 0, 0, 0>;

/// Thermodynamic temperature or a temperature difference (K). A reading on a scale with an offset (degC, degF) is a `Temperature`.
///
/// ```nabi
/// use units::kinds::ThermodynamicTemperature;
///
/// let q: ThermodynamicTemperature = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 0, 0, 0, 1, 0, 0]);
/// ```
pub type ThermodynamicTemperature<V = f64> = Quantity<V, 0, 0, 0, 0, 1, 0, 0>;

/// Amount of substance (mol).
///
/// ```nabi
/// use units::kinds::Amount;
///
/// let q: Amount = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 0, 0, 0, 0, 1, 0]);
/// ```
pub type Amount<V = f64> = Quantity<V, 0, 0, 0, 0, 0, 1, 0>;

/// Luminous intensity (cd); also luminous flux (lm = cd sr).
///
/// ```nabi
/// use units::kinds::LuminousIntensity;
///
/// let q: LuminousIntensity = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 0, 0, 0, 0, 0, 1]);
/// ```
pub type LuminousIntensity<V = f64> = Quantity<V, 0, 0, 0, 0, 0, 0, 1>;

/// Area (m²).
///
/// ```nabi
/// use units::kinds::Area;
///
/// let q: Area = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 0, 0, 0, 0, 0, 0]);
/// ```
pub type Area<V = f64> = Quantity<V, 2, 0, 0, 0, 0, 0, 0>;

/// Volume (m³).
///
/// ```nabi
/// use units::kinds::Volume;
///
/// let q: Volume = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [3, 0, 0, 0, 0, 0, 0]);
/// ```
pub type Volume<V = f64> = Quantity<V, 3, 0, 0, 0, 0, 0, 0>;

/// Wavenumber, curvature (1/m).
///
/// ```nabi
/// use units::kinds::Wavenumber;
///
/// let q: Wavenumber = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [-1, 0, 0, 0, 0, 0, 0]);
/// ```
pub type Wavenumber<V = f64> = Quantity<V, -1, 0, 0, 0, 0, 0, 0>;

/// Frequency, rate, angular velocity (1/s).
///
/// ```nabi
/// use units::kinds::Frequency;
///
/// let q: Frequency = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 0, -1, 0, 0, 0, 0]);
/// ```
pub type Frequency<V = f64> = Quantity<V, 0, 0, -1, 0, 0, 0, 0>;

/// Velocity (m/s).
///
/// ```nabi
/// use units::kinds::Velocity;
///
/// let q: Velocity = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [1, 0, -1, 0, 0, 0, 0]);
/// ```
pub type Velocity<V = f64> = Quantity<V, 1, 0, -1, 0, 0, 0, 0>;

/// Acceleration (m/s²).
///
/// ```nabi
/// use units::kinds::Acceleration;
///
/// let q: Acceleration = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [1, 0, -2, 0, 0, 0, 0]);
/// ```
pub type Acceleration<V = f64> = Quantity<V, 1, 0, -2, 0, 0, 0, 0>;

/// Jerk (m/s³).
///
/// ```nabi
/// use units::kinds::Jerk;
///
/// let q: Jerk = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [1, 0, -3, 0, 0, 0, 0]);
/// ```
pub type Jerk<V = f64> = Quantity<V, 1, 0, -3, 0, 0, 0, 0>;

/// Momentum, impulse (N·s).
///
/// ```nabi
/// use units::kinds::Momentum;
///
/// let q: Momentum = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [1, 1, -1, 0, 0, 0, 0]);
/// ```
pub type Momentum<V = f64> = Quantity<V, 1, 1, -1, 0, 0, 0, 0>;

/// Force (N).
///
/// ```nabi
/// use units::kinds::Force;
///
/// let q: Force = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [1, 1, -2, 0, 0, 0, 0]);
/// ```
pub type Force<V = f64> = Quantity<V, 1, 1, -2, 0, 0, 0, 0>;

/// Energy, work, heat, torque (J).
///
/// ```nabi
/// use units::kinds::Energy;
///
/// let q: Energy = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -2, 0, 0, 0, 0]);
/// ```
pub type Energy<V = f64> = Quantity<V, 2, 1, -2, 0, 0, 0, 0>;

/// Power (W).
///
/// ```nabi
/// use units::kinds::Power;
///
/// let q: Power = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -3, 0, 0, 0, 0]);
/// ```
pub type Power<V = f64> = Quantity<V, 2, 1, -3, 0, 0, 0, 0>;

/// Action, angular momentum (J·s).
///
/// ```nabi
/// use units::kinds::Action;
///
/// let q: Action = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -1, 0, 0, 0, 0]);
/// ```
pub type Action<V = f64> = Quantity<V, 2, 1, -1, 0, 0, 0, 0>;

/// Pressure, stress (Pa).
///
/// ```nabi
/// use units::kinds::Pressure;
///
/// let q: Pressure = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [-1, 1, -2, 0, 0, 0, 0]);
/// ```
pub type Pressure<V = f64> = Quantity<V, -1, 1, -2, 0, 0, 0, 0>;

/// Mass density (kg/m³).
///
/// ```nabi
/// use units::kinds::Density;
///
/// let q: Density = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [-3, 1, 0, 0, 0, 0, 0]);
/// ```
pub type Density<V = f64> = Quantity<V, -3, 1, 0, 0, 0, 0, 0>;

/// Dynamic viscosity (Pa·s).
///
/// ```nabi
/// use units::kinds::DynamicViscosity;
///
/// let q: DynamicViscosity = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [-1, 1, -1, 0, 0, 0, 0]);
/// ```
pub type DynamicViscosity<V = f64> = Quantity<V, -1, 1, -1, 0, 0, 0, 0>;

/// Kinematic viscosity, diffusivity (m²/s).
///
/// ```nabi
/// use units::kinds::KinematicViscosity;
///
/// let q: KinematicViscosity = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 0, -1, 0, 0, 0, 0]);
/// ```
pub type KinematicViscosity<V = f64> = Quantity<V, 2, 0, -1, 0, 0, 0, 0>;

/// Surface tension, stiffness (N/m).
///
/// ```nabi
/// use units::kinds::SurfaceTension;
///
/// let q: SurfaceTension = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 1, -2, 0, 0, 0, 0]);
/// ```
pub type SurfaceTension<V = f64> = Quantity<V, 0, 1, -2, 0, 0, 0, 0>;

/// Electric charge (C).
///
/// ```nabi
/// use units::kinds::Charge;
///
/// let q: Charge = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [0, 0, 1, 1, 0, 0, 0]);
/// ```
pub type Charge<V = f64> = Quantity<V, 0, 0, 1, 1, 0, 0, 0>;

/// Voltage, electric potential (V).
///
/// ```nabi
/// use units::kinds::Voltage;
///
/// let q: Voltage = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -3, -1, 0, 0, 0]);
/// ```
pub type Voltage<V = f64> = Quantity<V, 2, 1, -3, -1, 0, 0, 0>;

