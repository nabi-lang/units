///
/// ```nabi
/// use units::kinds::Resistance;
///
/// let q: Resistance = units::Quantity::si(1.0);
/// assert(q.dim().exponents() == [2, 1, -3, -2, 0, 0, 0]);
/// ```
pub type Resistance<V = f64> = Quantity<V, 2, 1, -3, -2, 0, 0, 0>;

